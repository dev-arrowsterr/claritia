# Supabase: Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only the test runner needs this (from Week 3). Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Seals environment secrets (test passwords, API keys) before they're saved.
# 32 or more random characters. Never change it once secrets are saved, or they can't be opened.
SECRETS_KEY=

# Optional: the domains the proxy splits between the site and the app.
# SITE_HOST=tryclaritia.com
# APP_HOST=app.tryclaritia.com
